{
    "name": "pietervanleuven/mautic-smtp2go-bundle",
    "description": "Provides SMTP2GO as an email transport for Mautic 5 using the SMTP2GO HTTP API.",
    "type": "mautic-plugin",
    "keywords": [
        "mautic",
        "plugin",
        "integration",
        "smtp2go",
        "email",
        "transport"
    ],
    "homepage": "https://github.com/pietervanleuven/mauticsmtp2gobundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Pieter van Leuven"
        }
    ],
    "require": {
        "php": ">=8.1",
        "mautic/core-lib": "^5.0"
    },
    "extra": {
        "install-directory-name": "MauticSmtp2goBundle"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticSmtp2goBundle\\": ""
        }
    },
    "minimum-stability": "dev"
}
